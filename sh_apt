# Make apt easier to type
# Use apt if installed

if hash apt
then
	APT=apt
	alias apts="apt search"
	alias aptlu="doas $APT list --upgradable"
	alias aptap="doas apt autoremove --purge"
else
	APT=apt-get
	alias apts="apt-cache search"
	alias aptap="dpkg -l | grep ^rc | cut -d ' ' -f 3 | xargs doas apt purge -y"
fi
alias aptu="doas $APT update"
alias aptdu="doas $APT dist-upgrade"
alias aptug="doas $APT upgrade"
alias apti="doas $APT install"
alias aptp="doas $APT purge"
alias aptar="doas $APT autoremove"
alias aptac="doas $APT autoclean"

